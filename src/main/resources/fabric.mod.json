{
  "schemaVersion": 1,
  "id": "justenoughbackups",
  "version": "${version}",
  "name": "Just Enough Backups",
  "description": "Server-side world backups with full, partial, and differential modes, restore support, retention rules, in-game management UI, and configurable backup announcements.",
  "authors": [
    "frandm16"
  ],
  "contact": {
    "sources": "https://github.com/frandm16/JustEnoughBackups"
  },
  "license": "MIT",
  "icon": "assets/justenoughbackups/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.frandm.justenoughbackups.WorldBackupMod"
    ],
    "client": [
      "com.frandm.justenoughbackups.client.JEBClient"
    ],
    "modmenu": [
      "com.frandm.justenoughbackups.client.JEBModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version_range}",
    "fabric-api": ">=${fabric_api_version}",
    "java": ">=${java_version}"
  }
}
